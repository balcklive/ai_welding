# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会入库）
# 远程存储服务已通过公网验证可用，真实值见私有 .env

# --- MinIO 对象存储（视频 / 图片 / 多模态文件）---
# 注意：MINIO_ENDPOINT 只能填裸 host:port（如 182.61.59.135:8290），勿带 http(s):// 前缀，
# minio SDK 不接受带 scheme 的 endpoint（会抛 "path in endpoint is not allowed"）。
MINIO_ENDPOINT=
MINIO_CONSOLE=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_BUCKET=aiwelding

# --- MySQL 数据库 ---
MYSQL_HOST=
MYSQL_PORT=8206
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_welding
MYSQL_CHARSET=utf8mb4

# --- 后端 ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123   # 启动 seed 管理员（本地演示默认值，生产务必修改）
SEED_DEMO=false           # 启动是否灌入演示数据集/焊缝/模型（默认 false，本地想看演示改 true）

# --- 接口调用日志（轮转，规范见 docs/开发规范.md §2）---
API_LOG_DIR=logs
API_LOG_ROTATION=10 MB
API_LOG_RETENTION=5

# --- MLflow（可选；配置后模型中心任务会写入实验、指标和产物）---
# embedded=直接运行在 FastAPI 进程；server=连接独立 Tracking Server；off=关闭
MLFLOW_MODE=embedded
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT=AI Welding
MLFLOW_ARTIFACT_ROOT=s3://aiwelding/mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=

# CPU 模拟训练
TORCH_CPU_THREADS=1

# 后台任务执行器；候选部署容器会强制覆盖为 false，生产容器默认 true
JOB_EXECUTOR_ENABLED=true
