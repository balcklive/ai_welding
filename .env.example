# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会入库）
# 远程存储服务已通过公网验证可用，真实值见私有 .env

# --- MinIO 对象存储（视频 / 图片 / 多模态文件）---
# 注意：MINIO_ENDPOINT 只能填裸 host:port（如 182.61.59.135:8290），勿带 http(s):// 前缀，
# minio SDK 不接受带 scheme 的 endpoint（会抛 "path in endpoint is not allowed"）。
MINIO_ENDPOINT=
# 服务端内网端点（可选，2026-09 内网化）：app/LS/mlflow 与 MinIO 同宿主时，填容器可直连的
# 内网地址（如 docker 网关 172.18.0.1:9000 或宿主私网 IP:9000，需先 ssh 上服务器 ip addr 核实），
# 让服务端数据面不走公网 hairpin；留空则与 MINIO_ENDPOINT 一致。
# 浏览器直传/下载的预签名 URL 恒由 MINIO_ENDPOINT（公网）生成，不受本字段影响。
MINIO_SERVER_ENDPOINT=
MINIO_CONSOLE=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_BUCKET=aiwelding

# --- MySQL 数据库 ---
MYSQL_HOST=
MYSQL_PORT=8206
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_welding
MYSQL_CHARSET=utf8mb4

# --- 后端 ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123   # 启动 seed 管理员（本地演示默认值，生产务必修改）
SEED_DEMO=false           # 启动是否灌入演示数据集/焊缝/模型（默认 false，本地想看演示改 true）

# --- 接口调用日志（轮转，规范见 docs/开发规范.md §2）---
API_LOG_DIR=logs
API_LOG_ROTATION=10 MB
API_LOG_RETENTION=5

# --- MLflow（可选；配置后模型中心任务会写入实验、指标和产物）---
# embedded=直接运行在 FastAPI 进程；server=连接独立 Tracking Server；off=关闭
MLFLOW_MODE=embedded
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MLFLOW_REGISTRY_URI=
MLFLOW_EXPERIMENT=AI Welding
MLFLOW_ARTIFACT_ROOT=s3://aiwelding/mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=

# CPU 模拟训练
TORCH_CPU_THREADS=1

# 后台任务执行器；候选部署容器会强制覆盖为 false，生产容器默认 true
JOB_EXECUTOR_ENABLED=true

# --- Docker Compose 辅助服务端口（2026-09-05；见 docker-compose.yml）---
# Label Studio / MLflow 宿主端口，默认 8224 / 8225。改端口只需改这里，compose 变量替换。
LABEL_STUDIO_PORT=8224
MLFLOW_PORT=8225

# --- 切换到独立 MLflow Tracking Server 时（Phase B，docker-compose 起 mlflow 后）---
# MLFLOW_MODE=server
# MLFLOW_TRACKING_URI=http://mlflow:5000   # app 与 mlflow 同网 aiwelding-net，按服务名访问

