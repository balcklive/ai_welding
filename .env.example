# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会入库）
# 远程存储服务已通过公网验证可用，真实值见私有 .env

# --- MinIO 对象存储（视频 / 图片 / 多模态文件）---
MINIO_ENDPOINT=
MINIO_CONSOLE=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_BUCKET=aiwelding

# --- MySQL 数据库 ---
MYSQL_HOST=
MYSQL_PORT=8206
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_welding
MYSQL_CHARSET=utf8mb4

# --- 后端 ---
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
